{{- /* JSON Feed 1.1 — https://jsonfeed.org/version/1.1 */ -}}
{{- $items := slice -}}
{{- $languageCode := "" -}}
{{- if ge hugo.Version "0.158.0" -}}
  {{- $languageCode = site.Language.Locale -}}
{{- else -}}
  {{- $languageCode = site.Language.LanguageCode -}}
{{- end -}}
{{- range partialCached "main-pages.html" . .Site.Language.Lang -}}
  {{- $dates := partial "page-dates.html" . -}}
  {{- $item := dict
    "id" .Permalink
    "url" .Permalink
    "title" .Title
    "content_text" (.Plain | htmlUnescape)
    "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00")
    "date_modified" ($dates.modified.Format "2006-01-02T15:04:05Z07:00")
  -}}
  {{- with partial "page-description.html" . -}}
    {{- $item = merge $item (dict "summary" .) -}}
  {{- end -}}
  {{- with .Params.categories -}}
    {{- $item = merge $item (dict "tags" .) -}}
  {{- end -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- $author := dict "name" (site.Params.authorName | default site.Title) -}}
{{- with site.Params.authorURL -}}
  {{- $author = merge $author (dict "url" .) -}}
{{- end -}}
{{- $feed := dict
  "version" "https://jsonfeed.org/version/1.1"
  "title" site.Title
  "home_page_url" site.Home.Permalink
  "feed_url" (.OutputFormats.Get "JSON").Permalink
  "language" $languageCode
  "authors" (slice $author)
  "items" $items
-}}
{{- with site.Params.description -}}
  {{- $feed = merge $feed (dict "description" (. | plainify | htmlUnescape)) -}}
{{- end -}}
{{- $feed | jsonify (dict "indent" "  ") -}}
