{{- /* JSON Feed 1.1 — https://jsonfeed.org/version/1.1 */ -}}
{{- $items := slice -}}
{{- $languageCode := "" -}}
{{- if ge hugo.Version "0.158.0" -}}
  {{- $languageCode = site.Language.Locale -}}
{{- else -}}
  {{- $languageCode = site.Language.LanguageCode -}}
{{- end -}}
{{- range partial "main-pages.html" . -}}
  {{- $item := dict
    "id" .Permalink
    "url" .Permalink
    "title" .Title
    "content_text" (.Plain | truncate 500)
    "summary" .Description
    "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00")
    "date_modified" (.Lastmod.Format "2006-01-02T15:04:05Z07:00")
  -}}
  {{- with .Params.categories -}}
    {{- $item = merge $item (dict "tags" .) -}}
  {{- end -}}
  {{- $items = $items | append $item -}}
{{- end -}}
{{- dict
  "version" "https://jsonfeed.org/version/1.1"
  "title" site.Title
  "home_page_url" site.BaseURL
  "feed_url" (printf "%sindex.json" site.BaseURL)
  "description" site.Params.description
  "language" $languageCode
  "authors" (slice (dict "name" (site.Params.authorName | default site.Title) "url" site.Params.authorURL))
  "items" $items
| jsonify (dict "indent" "  ") -}}
